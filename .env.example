# Copy to .env and fill in your keys. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Optional: override the default open model on Nebius Token Factory.
# NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
#
# Fallback for testing/demo while Nebius credits are pending: any
# OpenAI-compatible endpoint can stand in. Nebius stays the default —
# these three lines only take effect when LLM_BASE_URL is set.
# Example (Groq free tier, key is issued instantly at console.groq.com):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# Example (DeepSeek, pay-as-you-go ~$0.28/M input tokens — a full agent
# run costs a fraction of a cent; check the current model name on
# platform.deepseek.com, it changes as models rotate):
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-flash
